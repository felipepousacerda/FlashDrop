# ============================================================
# FlashDrop - Orders Service - LOCAL DEVELOPMENT PROFILE
# Este archivo se activa automáticamente con: spring.profiles.active=local
# Sobrescribe application.properties para desarrollo local contra Supabase
# ============================================================

# ----------------------------
# DataSource - Local H2 In-Memory Database (PostgreSQL mode)
# ----------------------------
spring.datasource.url=jdbc:h2:mem:ordersdb;DB_CLOSE_DELAY=-1;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE
spring.datasource.username=sa
spring.datasource.password=
spring.datasource.driver-class-name=org.h2.Driver

# HikariCP
spring.datasource.hikari.maximum-pool-size=5
spring.datasource.hikari.minimum-idle=1
spring.datasource.hikari.connection-timeout=10000

# ----------------------------
# Flyway - H2 running migrations
# ----------------------------
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration,classpath:db/migration_local
spring.flyway.init-sqls=CREATE DOMAIN IF NOT EXISTS TIMESTAMPTZ AS TIMESTAMP WITH TIME ZONE
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=1
spring.flyway.validate-on-migrate=false

# ----------------------------
# JPA - No alterar schema en Supabase, solo validar
# ----------------------------
spring.jpa.hibernate.ddl-auto=validate

# ----------------------------
# RabbitMQ - disabled locally (no bloqueará el arranque si falla)
# ----------------------------
spring.rabbitmq.host=localhost
spring.rabbitmq.port=5672
spring.rabbitmq.username=guest
spring.rabbitmq.password=guest

# ----------------------------
# Logging - más detalle en local
# ----------------------------
logging.level.cl.flashdrop=DEBUG
logging.level.org.springframework.jdbc=DEBUG
logging.level.org.flywaydb=DEBUG
